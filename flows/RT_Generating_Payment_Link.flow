    <actionCalls>
        <name>Create_the_Razorpay_Link</name>
        <label>Create the Razorpay Link</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>RazorpayFlowAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Update_the_Booking_Status</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>amount</name>
            <value>
                <elementReference>TokenAmount</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>bookingId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>customerName</name>
            <value>
                <elementReference>$Record.Account__r.Name</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>email</name>
            <value>
                <elementReference>Get_Name_Phone_and_Email.Email</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>paymentType</name>
            <value>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
                <stringValue>Booking Token Advance</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>phone</name>
            <value>
                <elementReference>Get_Name_Phone_and_Email.MobilePhone</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>upiOnly</name>
            <value>
                <booleanValue>false</booleanValue>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>RazorpayFlowAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>TokenAmount</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>500000.0</numberValue>
        </value>
    </constants>
    <decisions>
        <name>Initial_Payment</name>
        <label>Initial Payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Razorpay_Link_for_Next_Time</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Total_Paid_Amount__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_the_Razorpay_Link</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>For_50PercentAmount</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Final_Agreed_Price__c} *0.5</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>For_Amount</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Final_Agreed_Price__c} - {!TokenAmount})/6</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>For_PropertyStatus</name>
        <dataType>String</dataType>
        <expression>IF(
{!$Record.Total_Paid_Amount__c} == {!TokenAmount},
&apos;Reserved&apos;,
&apos;Sold&apos;
)</expression>
    </formulas>
    <formulas>
        <name>For_UpdatingBookingStatus</name>
        <dataType>String</dataType>
        <expression>IF( {!$Record.Total_Paid_Amount__c} = {!TokenAmount},
&apos;Token Received&apos; ,
IF({!$Record.Final_Agreed_Price__c} == {!$Record.Total_Paid_Amount__c} &amp;&amp; {!$Record.Balance_Due__c} = 0,
&apos;Sale Agreement Executed&apos;,
&apos;Token Received&apos; 
)


)</expression>
    </formulas>
    <interviewLabel>RT : Generating Payment Link {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RT : Generating Payment Link</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Name_Phone_and_Email</name>
        <label>Get Name Phone and Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Property_Unit</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>MobilePhone</queriedFields>
        <queriedFields>Email</queriedFields>
        <queriedFields>Phone</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Property_Unit</name>
        <label>Get Property Unit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Initial_Payment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Property_Unit__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Property_Unit__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Property_Unit_Status</name>
        <label>Update Property Unit Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_2</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Under Offer</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>For_PropertyStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Property_Unit__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_the_Booking_Status</name>
        <label>Update the Booking Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Property_Unit_Status</targetReference>
        </connector>
        <inputAssignments>
            <field>Booking_Status__c</field>
            <value>
                <elementReference>For_UpdatingBookingStatus</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Name_Phone_and_Email</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Final_Agreed_Price__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Booking_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Waiting Token Payement</stringValue>
            </value>
        </filters>
        <object>Booking__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
