            <value>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
                <stringValue>Balance Settlement</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>phone</name>
            <value>
                <elementReference>Get_Name_Phone_and_Email.MobilePhone</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>upiOnly</name>
            <value>
                <booleanValue>false</booleanValue>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
