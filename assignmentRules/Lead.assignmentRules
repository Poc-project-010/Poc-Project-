<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Test</fullName>
        <active>false</active>
    </assignmentRule>
    <assignmentRule>
        <fullName>UrbanNest Location Routing</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Chennai_queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Location_Preference__c</field>
                <operation>equals</operation>
                <value>Chennai</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Hyderbad_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Location_Preference__c</field>
                <operation>equals</operation>
                <value>Hyderabad</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>General_Sales_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>AND(
    Location_Preference__c &lt;&gt; &quot;Chennai&quot;,
    Location_Preference__c &lt;&gt; &quot;Hyderabad&quot;
)</formula>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
