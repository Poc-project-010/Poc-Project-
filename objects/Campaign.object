<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>QR_Code__c</fullName>
        <externalId>false</externalId>
        <formula>IMAGE(
    &quot;https://api.qrserver.com/v1/create-qr-code/?size=250x250&amp;data=https://ajsd9--devsandbox.sandbox.my.site.com/UrbanNest/contact%3FcampaignId%3D&quot; + Id,
    &quot;Scan to Enquire&quot;,
    200,
    200
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>QR Code</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
