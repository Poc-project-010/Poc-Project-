        <searchResultsAdditionalFields>Next_Follow_Up_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Sales_Executive__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
