    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores qualitative site walkthrough survey reports, customer interest scoring, budget suitability, and buyer objections.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Site Visit Feedback</label>
    <nameField>
        <displayFormat>SVF-{00000}</displayFormat>
        <label>Feedback Ref</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Site Visit Feedbacks</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Lead__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Project_Visited__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Visit_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Overall_Rating__c</customTabListAdditionalFields>
