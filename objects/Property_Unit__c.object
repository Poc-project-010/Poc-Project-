                </value>
                <value>
                    <fullName>Grade-A Office Suite</fullName>
                    <default>false</default>
                    <label>Grade-A Office Suite</label>
                </value>
                <value>
                    <fullName>Retail Showroom</fullName>
                    <default>false</default>
                    <label>Retail Showroom</label>
                </value>
                <value>
