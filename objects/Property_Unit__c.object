        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Price__c</fullName>
        <description>Total pricing or starting price for this property unit.</description>
        <label>Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <description>Reference to the parent Project through Phase.</description>
        <externalId>false</externalId>
        <formula>CASESAFEID(Phase__r.Project__c)</formula>
        <label>Project Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Property_Identifier__c</fullName>
        <description>This fields is created for back end Purpose. To reprensent Icon on the Units Fields.. This is field Not be in in the UI</description>
        <externalId>false</externalId>
        <formula>TEXT(Phase__r.Project__r.Project_Type__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Property Identifier</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sample_Photo_Content_Key__c</fullName>
        <description>CMS Content Key or Image URL for interior sample flat/villa/office photography.</description>
        <externalId>false</externalId>
        <label>Sample Photo Content Key</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Inventory lifecycle state. Supports all 5 standard lifecycle statuses.</description>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Available</fullName>
                    <default>false</default>
                    <label>Available</label>
                </value>
                <value>
                    <fullName>Under Offer</fullName>
                    <default>false</default>
                    <label>Under Offer</label>
                </value>
                <value>
                    <fullName>Reserved</fullName>
                    <default>false</default>
                    <label>Reserved</label>
                </value>
                <value>
                    <fullName>Sold</fullName>
                    <default>false</default>
                    <label>Sold</label>
                </value>
                <value>
                    <fullName>Occupied</fullName>
                    <default>false</default>
                    <label>Occupied</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Super_Built_Up_Area__c</fullName>
        <description>Total super built-up area including loading and common spaces in square feet.</description>
        <externalId>false</externalId>
        <label>Super Built-Up Area (Sq.Ft)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_All_Inclusive_Price__c</fullName>
        <description>All-inclusive purchase cost comprising base unit price, amenities/infrastructure fee, and advance maintenance.</description>
        <formula>BLANKVALUE(Price__c, 0) + Amenities_Charge__c + Advance_Maintenance_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Base Unit Price + Amenities Charge + Advance Maintenance Amount.</inlineHelpText>
        <label>Total All-Inclusive Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Unit_Type__c</fullName>
        <description>Specific inventory configuration category across apartments, villas, and commercial spaces.</description>
        <label>Unit Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
