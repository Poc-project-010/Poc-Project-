<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Advance_Maintenance_Amount__c</fullName>
        <description>Total advance maintenance (CAM) calculated for the advance period based on unit area and project monthly rate.</description>
        <formula>BLANKVALUE(Super_Built_Up_Area__c, BLANKVALUE(Carpet_Area__c, 0)) * BLANKVALUE(Phase__r.Project__r.Maintenance_Rate_Per_SqFt__c, 0) * (BLANKVALUE(Phase__r.Project__r.Advance_Maintenance_Years__c, 3) * 12)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Auto-calculated: Area (sq.ft) × Monthly Rate × (Advance Years × 12 months).</inlineHelpText>
        <label>Advance Maintenance Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Amenities_Charge__c</fullName>
        <description>One-time amenities and infrastructure development fee inherited from parent project.</description>
        <formula>BLANKVALUE(Phase__r.Project__r.Amenities_Infrastructure_Charge__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Inherited from Project Amenities &amp; Infrastructure Charge.</inlineHelpText>
        <label>Amenities &amp; Infrastructure Charge</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>BHK__c</fullName>
        <description>Bedroom configuration (applicable to residential apartments and villas).</description>
        <label>BHK</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1 BHK</fullName>
                    <default>false</default>
                    <label>1 BHK</label>
                </value>
                <value>
                    <fullName>2 BHK</fullName>
                    <default>false</default>
                    <label>2 BHK</label>
                </value>
                <value>
                    <fullName>3 BHK</fullName>
                    <default>false</default>
                    <label>3 BHK</label>
                </value>
                <value>
                    <fullName>4 BHK</fullName>
                    <default>false</default>
                    <label>4 BHK</label>
                </value>
                <value>
                    <fullName>5 BHK</fullName>
                    <default>false</default>
                    <label>5 BHK</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Base_Rate_Per_SqFt__c</fullName>
        <description>Base selling rate per square foot for this property unit.</description>
        <inlineHelpText>Enter the base price per sq.ft (e.g. ₹5,500). System will auto-calculate Base Price based on unit area.</inlineHelpText>
        <label>Base Rate Per Sq.Ft</label>
        <precision>16</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Bathrooms__c</fullName>
        <description>Number of bathrooms/restrooms.</description>
        <externalId>false</externalId>
        <label>Bathrooms</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Billable_Area__c</fullName>
        <description>Effective saleable / billable area in square feet depending on record type (Super Built-Up Area for Apartment/Commercial, Plot Area/Carpet Area for Villa).</description>
        <externalId>false</externalId>
        <formula>IF(RecordType.DeveloperName = &apos;Villa_Unit&apos;, 
   BLANKVALUE(Plot_Area__c, BLANKVALUE(Carpet_Area__c, 0)), 
   BLANKVALUE(Super_Built_Up_Area__c, BLANKVALUE(Carpet_Area__c, 0))
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Effective pricing area: Super Built-Up for Apartment/Commercial; Plot/Carpet for Villa.</inlineHelpText>
        <label>Billable Area (Sq.Ft)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Carpet_Area__c</fullName>
        <description>Usable RERA carpet area in square feet.</description>
        <externalId>false</externalId>
        <label>Carpet Area (Sq.Ft)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Current_Booking__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lead enquiry that holds the current reservation or blocking.</description>
        <label>Current Booking</label>
        <referenceTo>Lead</referenceTo>
        <relationshipLabel>Booked Units</relationshipLabel>
        <relationshipName>Booked_Units</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
