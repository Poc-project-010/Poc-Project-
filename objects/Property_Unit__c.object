        <description>Furnishing handover state (especially important for commercial and high-end villas).</description>
        <label>Furnishing Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Unfurnished</fullName>
                    <default>true</default>
                    <label>Unfurnished</label>
                </value>
                <value>
                    <fullName>Semi-Furnished</fullName>
                    <default>false</default>
                    <label>Semi-Furnished</label>
                </value>
                <value>
                    <fullName>Fully Furnished</fullName>
                    <default>false</default>
                    <label>Fully Furnished</label>
                </value>
                <value>
                    <fullName>Bare Shell</fullName>
                    <default>false</default>
                    <label>Bare Shell</label>
                </value>
                <value>
                    <fullName>Warm Shell</fullName>
                    <default>false</default>
                    <label>Warm Shell</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Parking_Available__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates whether dedicated covered parking or EV slot is allotted.</description>
        <label>Parking Available</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Plot_Area__c</fullName>
        <description>Total land/plot parcel area in square feet (specifically for Villas and Plotted developments).</description>
        <externalId>false</externalId>
        <label>Plot Area (Sq.Ft)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Possession_Date__c</fullName>
        <description>Target date for key handover.</description>
        <label>Possession Date</label>
